# Backend du site (projet Supabase). À copier en `.env.local`.
VITE_SUPABASE_URL=https://<projet>.supabase.co
VITE_SUPABASE_ANON_KEY=<clé publishable>
# Mesure d'audience (PostHog, projet UE). Sans elles, ni mesure ni bandeau de consentement.
VITE_POSTHOG_KEY=phc_<jeton du projet>
VITE_POSTHOG_HOST=https://eu.i.posthog.com
